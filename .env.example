# Copy this file to .env and fill in real values from your Firebase project:
# Firebase console -> Project settings -> General -> Your apps -> SDK setup and configuration.
#
# These EXPO_PUBLIC_* values are the public Firebase *client* config (apiKey
# etc.) — Firebase's own docs confirm this is not a secret; what actually
# protects your data is Firestore Security Rules + Authentication, not hiding
# this config. Never put a private service-account key or any server-side
# secret in this file or anywhere in the app.
#
# Leave everything blank to run the app fully offline with no cloud features
# (Phase 1/2 functionality is unaffected either way).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In OAuth client IDs (Google Cloud console, created when you
# enable the Google provider in Firebase Auth). Needed only for native
# Google sign-in; the web flow uses the Firebase Auth Domain above instead.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Set to 1 to point the app at a local Firebase emulator suite instead of
# production (see `firebase.json`). Used for development/testing only.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=
